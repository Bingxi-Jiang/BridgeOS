# BridgeOS runs without third-party credentials in explicit local fallback mode.
# Add an OpenAI API key to make extraction, grounded Q&A, and drafts model-backed.
HOST=127.0.0.1
PORT=4174
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DATA_FILE=./data/memory-store.json

# true gives every server restart a clean, reliable judge demo.
# Set false when you want memories to survive restarts.
RESET_STORE_ON_START=true
