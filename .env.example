# BridgeOS runs without third-party credentials in explicit local fallback mode.
# Add sponsor credentials below to activate the same end-to-end workflow with live APIs.
HOST=127.0.0.1
PORT=4174

# Reasoning provider. auto prefers Meta when MODEL_API_KEY exists, then OpenAI.
AI_PROVIDER=auto
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Voice capture and conversational voice
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_DIARIZE_MODEL=latest
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Searchable relationship memory
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=bridgeos-memory

# Document and note import
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT_PATH=

DATA_FILE=./data/memory-store.json

# true gives every server restart a clean, reliable judge demo.
# Set false when you want memories to survive restarts.
RESET_STORE_ON_START=true
